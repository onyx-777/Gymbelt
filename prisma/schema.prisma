generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GYM_OWNER
  MEMBER
  USER
}

enum Provider {
  oauth_google
  oauth_apple
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAIL
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum CashfreeKYCstatus {
  MIN_KYC_PENDING
  MIN_KYC_SUBMITTED
  MIN_KYC_APPROVED
  MIN_KYC_REJECTED
}

enum Cashfree_Payment_activation_status {
  PENDING
  ACTIVE
}

model User {
  id            String          @id @default(uuid())
  clerkId       String          @unique
  oauth         Provider
  firstName     String?
  lastName      String?
  username      String?         @unique
  avatar        String?
  email         String          @unique
  phoneNumber   String?         @unique
  role          Role?           @default(USER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  GymMembership GymMembership[]
  gymId         String?
  Gym           Gym?            @relation(fields: [gymId], references: [id])
}

model Gym {
  id                        String                             @id @default(uuid())
  cashfreeMerchantId        String                             @unique
  kyc_status                CashfreeKYCstatus                  @default(MIN_KYC_PENDING)
  Payment_activation_status Cashfree_Payment_activation_status @default(PENDING)
  name                      String
  logo                      String
  streetAddress             String
  city                      String
  state                     String
  pinCode                   String
  phoneNumber               String
  email                     String
  businessModel             String
  businessType              String
  website                   String?
  slogan                    String
  subdomain                 String                             @unique
  description               String?
  facilities                String[]
  services                  String[]
  isVerified                Boolean                            @default(false)
  isActive                  Boolean                            @default(true)
  isTrial                   Boolean                            @default(true)
  trialEndsAt               DateTime?
  trialStartedAt            DateTime?
  planStartedAt             DateTime?
  planEndsAt                DateTime?
  planStatus                String                             @default("active")
  GST_Number                String?
  GST_Registered            Boolean                            @default(false)
  License_Number            String?
  membershipTemplates       MembershipTemplate[] // 👈 Predefined plans
  memberships               GymMembership[] // 👈 Subscribed users
  Payment                   Payment[]
  createdAt                 DateTime                           @default(now())
  updatedAt                 DateTime                           @updatedAt
  ownerId                   String?
  owner                     User[]
}

model MembershipTemplate {
  id         String   @id @default(uuid())
  gymId      String
  planName   String
  services   String[]
  facilities String[]
  duration   String
  price      String
  createdAt  DateTime @default(now())

  gym            Gym             @relation(fields: [gymId], references: [id])
  gymMemberships GymMembership[]
}

model GymMembership {
  id                   String           @id @default(uuid())
  gymId                String
  userId               String
  membershipTemplateId String
  membershipStatus     MembershipStatus @default(INACTIVE)
  isPaid               Boolean          @default(false)
  startedAt            DateTime         @default(now())
  expiresAt            DateTime
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  gym                Gym                @relation(fields: [gymId], references: [id])
  user               User               @relation(fields: [userId], references: [id])
  membershipTemplate MembershipTemplate @relation(fields: [membershipTemplateId], references: [id])
  Payment            Payment[]

  @@index([gymId, userId])
}

